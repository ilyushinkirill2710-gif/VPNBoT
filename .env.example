# ---------- Telegram ----------
# Get it from @BotFather
BOT_TOKEN=123456:ABCDEF
# Comma-separated list of Telegram user IDs with admin access
ADMIN_IDS=

# ---------- Database ----------
# Default: local SQLite file. For production use Postgres, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/vpnbot
DATABASE_URL=sqlite+aiosqlite:///./data/vpnbot.sqlite3

# ---------- Remnawave ----------
# URL of your Remnawave panel (without trailing slash)
REMNAWAVE_BASE_URL=https://panel.example.com
# API token from Remnawave panel (Settings → API Tokens)
REMNAWAVE_TOKEN=
# Optional: Caddy token if your panel is behind Caddy auth
REMNAWAVE_CADDY_TOKEN=
# Comma-separated UUIDs of Internal Squads to attach to new users.
# Leave empty to attach the single available squad automatically.
REMNAWAVE_SQUAD_UUIDS=
# Per-user traffic limit in GB (0 = unlimited)
REMNAWAVE_TRAFFIC_LIMIT_GB=0

# ---------- platega.io ----------
# Credentials from https://app.platega.io/ (Settings tab)
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Base URL of the platega API
PLATEGA_BASE_URL=https://app.platega.io
# Payment method: 2 = SBP/QR, 3 = Card, 11/12/13 = crypto. See platega docs.
PLATEGA_PAYMENT_METHOD=2
# Callback URL (must be public HTTPS) that platega will call on payment status change.
# Example: https://bot.example.com/platega/callback
PLATEGA_CALLBACK_URL=https://bot.example.com/platega/callback
# URLs to redirect the customer to after a successful/failed payment
PLATEGA_RETURN_URL=https://t.me/your_bot_username
PLATEGA_FAIL_URL=https://t.me/your_bot_username

# ---------- Webhook server ----------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# ---------- Misc ----------
LOG_LEVEL=INFO
# Support contact shown in the bot
SUPPORT_USERNAME=@your_support
